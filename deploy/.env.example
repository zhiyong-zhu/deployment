# CICT Docker Compose 环境变量模板。
# install.sh 首次安装时会把 __RANDOM_HEX_<字节数>__ 占位符替换为 openssl rand -hex 生成的随机值，
# __CICT_IMAGE_TAG__ 由 build-bundle.sh 替换为实际后端镜像版本号。
# 手工使用时请自行替换全部占位符，并把文件改名为 .env，权限 600。

# ===== MariaDB =====
MARIADB_ROOT_PASSWORD=__RANDOM_HEX_24__
MARIADB_DATABASE=cict
MARIADB_USER=cict
MARIADB_PASSWORD=__RANDOM_HEX_24__

# ===== Redis =====
REDIS_PASSWORD=__RANDOM_HEX_24__

# ===== RabbitMQ =====
RABBITMQ_DEFAULT_USER=cict
RABBITMQ_DEFAULT_PASS=__RANDOM_HEX_24__
RABBITMQ_ADMIN_PASSWORD=__RANDOM_HEX_24__

# ===== RustFS =====
RUSTFS_ACCESS_KEY=__RANDOM_HEX_16__
RUSTFS_SECRET_KEY=__RANDOM_HEX_32__

# ===== CICT 后端 =====
JAVA_TOOL_OPTIONS=-Xms1g -Xmx4g
CICT_IMAGE_TAG=__CICT_IMAGE_TAG__
# S3 对外地址：浏览器直传预签 URL 使用。RustFS 已对外发布，可直接填 http://<服务器IP>:9000；
# 或与前端同协议/主机/端口走 nginx 的 /pike/ 转发（如 http://192.168.71.128）。
# 留空则回退容器内地址 http://rustfs:9000（仅服务器侧可访问，浏览器直传会失败）
CICT_PUBLIC_S3_ENDPOINT=

# ===== 对外端口 =====
NGINX_PORT=80
# 后端 API 直连端口（绑定 0.0.0.0）：外部系统绕过 nginx 直连 http://<服务器IP>:9090；
# nginx 的 /api/ 反代仍是统一入口，直连端口请在防火墙限制来源网段
CICT_PORT=9090
# MariaDB 直连端口（绑定 0.0.0.0）：外部客户端/运维工具远程连接用，
# 账号为 MARIADB_USER（镜像默认允许任意来源主机，密码即 MARIADB_PASSWORD）；root 仅限容器内
MARIADB_PORT=3306
# RabbitMQ 管理端口绑定地址（默认仅本机，远程访问走 SSH 隧道）
ADMIN_BIND_ADDRESS=127.0.0.1
RABBITMQ_MGMT_PORT=15672
# RustFS S3/控制台端口对外发布（默认 0.0.0.0，供预签 URL 与外部 S3 工具直连；
# 仅凭 AK/SK 认证，生产环境请在防火墙限制来源网段；如需收回仅本机访问，改为 127.0.0.1）
RUSTFS_BIND_ADDRESS=0.0.0.0
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
